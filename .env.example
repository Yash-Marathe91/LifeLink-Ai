# SUPABASE CLOUD CONFIGURATION
NEXT_PUBLIC_SUPABASE_URL="https://zjzlfuabmchbwzjeyqgf.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"

# DATABASE CONFIGURATION (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://postgres:password@localhost:5432/lifelink_ai?sslmode=disable"
DIRECT_URL="postgresql://postgres:password@localhost:5432/lifelink_ai?sslmode=disable"

# REDIS CONFIGURATION (Real-Time Mesh & Pub/Sub)
REDIS_URL="redis://localhost:6379"

# AUTHENTICATION & SECURITY (JWT / NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-jwt-key-here"
JWT_SECRET_KEY="your-backend-jwt-secret-key"

# AI & INTELLIGENCE ENGINES (Gemini 3.1 Pro)
GEMINI_API_KEY="your_gemini_api_key_here"

# GEOSPATIAL & TACTICAL MAPS
NEXT_PUBLIC_MAPBOX_TOKEN="your_mapbox_public_token_here"
NEXT_PUBLIC_MAP_TILE_SERVER="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# PUBLIC APPLICATION SETTINGS
NEXT_PUBLIC_APP_NAME="LifeLink AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
