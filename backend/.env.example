# ==============================================================================
# LIFELINK AI BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. SUPABASE PROJECT CREDENTIALS
# Find these in your Supabase Dashboard: Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# 2. SUPABASE POSTGRESQL CONNECTION STRING
# Direct connection (Session mode, port 5432) OR Pooled connection (port 6543):
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 3. FASTAPI SERVER SETTINGS
PORT=8000
DEBUG=True

# 4. AI RISK ENGINE & TRIAGE
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 5. OPEN GOVERNMENT DATA (DATA.GOV.IN) TELEMETRY
OGD_API_KEY=your_data_gov_in_api_key_here
